# A new staging directory prevents files retained from older builds entering a release.
foreach(required BUILD_DIR DATA_DIR PLUGIN_FILE PLUGIN_NAME ARCHIVE_NAME)
    if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
        message(FATAL_ERROR "Missing packaging argument: ${required}")
    endif()
endforeach()
if(NOT IS_ABSOLUTE "${BUILD_DIR}" OR NOT IS_DIRECTORY "${BUILD_DIR}")
    message(FATAL_ERROR "Packaging needs an existing absolute build directory")
endif()
file(REAL_PATH "${BUILD_DIR}" package_root)
string(RANDOM LENGTH 24 ALPHABET 0123456789abcdef nonce)
set(stage "${package_root}/release-stage-${nonce}")
file(MAKE_DIRECTORY "${stage}/F4SE/Plugins")
file(COPY_FILE "${PLUGIN_FILE}" "${stage}/F4SE/Plugins/${PLUGIN_NAME}.dll")
file(COPY_FILE "${DATA_DIR}/F4SE/Plugins/${PLUGIN_NAME}.ini"
    "${stage}/F4SE/Plugins/${PLUGIN_NAME}.ini")
file(COPY "${DATA_DIR}/Textures" DESTINATION "${stage}")
# The in-game menu (Mod Configuration Menu): its layout and defaults, never a user's choices.
if(IS_DIRECTORY "${DATA_DIR}/MCM/Config")
    file(COPY "${DATA_DIR}/MCM/Config" DESTINATION "${stage}/MCM")
endif()
# Reject unexpected executables even if accidentally placed under the asset tree.
file(GLOB_RECURSE staged_files RELATIVE "${stage}" "${stage}/*")
foreach(entry IN LISTS staged_files)
    string(TOLOWER "${entry}" lower_entry)
    if(lower_entry MATCHES "\\.(dll|exe|pdb|ps1|py|bat|cmd)$" AND
        NOT entry STREQUAL "F4SE/Plugins/${PLUGIN_NAME}.dll")
        message(FATAL_ERROR "Unexpected executable/helper in release: ${entry}")
    endif()
endforeach()
set(temporary_archive "${package_root}/${ARCHIVE_NAME}.${nonce}.tmp")
execute_process(COMMAND "${CMAKE_COMMAND}" -E tar cf "${temporary_archive}" --format=7zip -- .
    WORKING_DIRECTORY "${stage}" RESULT_VARIABLE package_result)
if(NOT package_result EQUAL 0)
    message(FATAL_ERROR "Release archive creation failed: ${package_result}")
endif()
file(RENAME "${temporary_archive}" "${package_root}/${ARCHIVE_NAME}")
# Resolve and constrain the generated path before recursive cleanup.
file(REAL_PATH "${stage}" resolved_stage)
cmake_path(IS_PREFIX package_root "${resolved_stage}" NORMALIZE inside_build)
if(NOT inside_build OR NOT resolved_stage STREQUAL stage OR IS_SYMLINK "${stage}")
    message(FATAL_ERROR "Unsafe package staging cleanup path: ${resolved_stage}")
endif()
file(REMOVE_RECURSE "${resolved_stage}")
